---
---

<section>
    <div class="flex items-center space-x-3 mb-8 pb-3 border-b border-slate-200">
        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold">
            <i class="fa-solid fa-award text-lg"></i>
        </div>
        <div>
            <h2 class="font-heading text-2xl font-bold text-slate-900">Certificates & Licenses</h2>
            <p class="text-xs text-slate-500">Verified credentials and professional certifications (Click to view full preview)</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Cert Card 1 -->
        <div class="cert-card bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all cursor-pointer group"
             data-img="https://images.unsplash.com/photo-1606326608606-aa0b62935f2b?q=80&w=1000&auto=format&fit=crop"
             data-title="Google IT Support Professional Certificate"
             data-issuer="Google / Coursera"
             data-date="2024">
            <div class="h-40 bg-slate-100 relative overflow-hidden">
                <img src="https://images.unsplash.com/photo-1606326608606-aa0b62935f2b?q=80&w=600&auto=format&fit=crop" alt="Google Certificate" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                <div class="absolute inset-0 bg-slate-900/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white font-semibold text-xs">
                    <i class="fa-solid fa-expand text-lg mr-2"></i> Click to Zoom
                </div>
            </div>
            <div class="p-4">
                <h4 class="font-heading font-bold text-slate-900 text-sm line-clamp-1">Google IT Support Professional</h4>
                <p class="text-xs text-brand-purple font-semibold mt-1">Google / Coursera</p>
                <p class="text-xs text-slate-400 mt-0.5">Issued 2024</p>
            </div>
        </div>

        <!-- Cert Card 2 -->
        <div class="cert-card bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all cursor-pointer group"
             data-img="https://images.unsplash.com/photo-1589330694653-ded6df03f754?q=80&w=1000&auto=format&fit=crop"
             data-title="Meta Front-End Developer Specialization"
             data-issuer="Meta / Coursera"
             data-date="2024">
            <div class="h-40 bg-slate-100 relative overflow-hidden">
                <img src="https://images.unsplash.com/photo-1589330694653-ded6df03f754?q=80&w=600&auto=format&fit=crop" alt="Meta Certificate" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                <div class="absolute inset-0 bg-slate-900/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white font-semibold text-xs">
                    <i class="fa-solid fa-expand text-lg mr-2"></i> Click to Zoom
                </div>
            </div>
            <div class="p-4">
                <h4 class="font-heading font-bold text-slate-900 text-sm line-clamp-1">Meta Front-End Developer</h4>
                <p class="text-xs text-brand-purple font-semibold mt-1">Meta / Coursera</p>
                <p class="text-xs text-slate-400 mt-0.5">Issued 2024</p>
            </div>
        </div>

        <!-- Cert Card 3 -->
        <div class="cert-card bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all cursor-pointer group"
             data-img="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1000&auto=format&fit=crop"
             data-title="Figma UI/UX Design Masterclass"
             data-issuer="Udemy"
             data-date="2023">
            <div class="h-40 bg-slate-100 relative overflow-hidden">
                <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=600&auto=format&fit=crop" alt="Figma Certificate" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                <div class="absolute inset-0 bg-slate-900/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white font-semibold text-xs">
                    <i class="fa-solid fa-expand text-lg mr-2"></i> Click to Zoom
                </div>
            </div>
            <div class="p-4">
                <h4 class="font-heading font-bold text-slate-900 text-sm line-clamp-1">Figma UI/UX Design Masterclass</h4>
                <p class="text-xs text-brand-purple font-semibold mt-1">Udemy</p>
                <p class="text-xs text-slate-400 mt-0.5">Issued 2023</p>
            </div>
        </div>

        <!-- Cert Card 4 -->
        <div class="cert-card bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all cursor-pointer group"
             data-img="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?q=80&w=1000&auto=format&fit=crop"
             data-title="Certified Digital Marketing Associate"
             data-issuer="HubSpot Academy"
             data-date="2024">
            <div class="h-40 bg-slate-100 relative overflow-hidden">
                <img src="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?q=80&w=600&auto=format&fit=crop" alt="Marketing Certificate" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                <div class="absolute inset-0 bg-slate-900/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white font-semibold text-xs">
                    <i class="fa-solid fa-expand text-lg mr-2"></i> Click to Zoom
                </div>
            </div>
            <div class="p-4">
                <h4 class="font-heading font-bold text-slate-900 text-sm line-clamp-1">Digital Marketing Associate</h4>
                <p class="text-xs text-brand-purple font-semibold mt-1">HubSpot Academy</p>
                <p class="text-xs text-slate-400 mt-0.5">Issued 2024</p>
            </div>
        </div>
    </div>
</section>

<script>
    document.querySelectorAll('.cert-card').forEach(card => {
        card.addEventListener('click', () => {
            const imgSrc = card.getAttribute('data-img') || '';
            const title = card.getAttribute('data-title') || '';
            const issuer = card.getAttribute('data-issuer') || '';
            const date = card.getAttribute('data-date') || '';

            const modal = document.getElementById('cert-modal');
            const img = document.getElementById('cert-modal-img') as HTMLImageElement;
            const titleEl = document.getElementById('cert-modal-title');
            const metaEl = document.getElementById('cert-modal-meta');

            if (modal && img && titleEl && metaEl) {
                img.src = imgSrc;
                titleEl.textContent = title;
                metaEl.textContent = `${issuer} • Issued ${date}`;
                modal.classList.remove('hidden');
            }
        });
    });
</script>
