---
---

<section>
    <div class="flex items-center space-x-3 mb-8 pb-3 border-b border-slate-200">
        <div class="w-10 h-10 rounded-xl bg-purple-100 text-brand-purple flex items-center justify-center font-bold">
            <i class="fa-solid fa-users text-lg"></i>
        </div>
        <div>
            <h2 class="font-heading text-2xl font-bold text-slate-900">Organization Experience</h2>
            <p class="text-xs text-slate-500">Leadership and active student council involvements</p>
        </div>
    </div>

    <div class="space-y-8">
        <!-- Org Item 1 -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                <div class="lg:col-span-7">
                    <span class="px-3 py-1 bg-purple-100 text-brand-purple text-xs font-semibold rounded-full mb-2 inline-block">Student Executive Board (BEM)</span>
                    <h3 class="font-heading text-xl font-bold text-slate-900 mb-1">Head of Information & Technology Division</h3>
                    <p class="text-slate-500 text-xs mb-4">Ciputra University • 2024 - 2025</p>
                    <p class="text-slate-600 text-sm leading-relaxed mb-4">
                        Led a team of 8 IT and media staff responsible for developing student portals, managing digital registration systems, and running technical operations for university-wide student events.
                    </p>
                </div>
                <div class="lg:col-span-5">
                    <!-- Swiper Carousel -->
                    <div class="swiper orgSwiper rounded-xl overflow-hidden border border-slate-200 shadow-sm">
                        <div class="swiper-wrapper">
                            <div class="swiper-slide">
                                <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=800&auto=format&fit=crop" alt="Team meeting" class="w-full h-48 object-cover">
                            </div>
                            <div class="swiper-slide">
                                <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=800&auto=format&fit=crop" alt="Tech workshop" class="w-full h-48 object-cover">
                            </div>
                        </div>
                        <div class="swiper-button-next"></div>
                        <div class="swiper-button-prev"></div>
                        <div class="swiper-pagination"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
