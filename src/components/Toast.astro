<!-- Toast Notification -->
<div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-900 text-white px-5 py-3.5 rounded-xl shadow-2xl flex items-center space-x-3 border border-slate-700">
    <div id="toast-icon" class="text-emerald-400">
        <i class="fa-solid fa-circle-check text-lg"></i>
    </div>
    <span id="toast-message" class="text-sm font-semibold">Notification message</span>
</div>
