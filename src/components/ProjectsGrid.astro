---
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

        <!-- Project 1 (IT) -->
        <div data-category="it" class="project-card bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300">
            <div class="h-48 bg-slate-100 relative overflow-hidden">
                <img src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?q=80&w=800&auto=format&fit=crop" alt="EduTech Campus Portal" class="w-full h-full object-cover">
                <span class="absolute top-3 left-3 px-3 py-1 bg-blue-600 text-white text-xs font-bold rounded-full">IT & Web</span>
            </div>
            <div class="p-6">
                <h3 class="font-heading font-bold text-lg text-slate-900 mb-2">EduTech Campus Portal</h3>
                <p class="text-slate-600 text-xs sm:text-sm line-clamp-2 mb-4">
                    Student portal & assignment submission system built with modern React & Tailwind CSS.
                </p>
                <button data-project="it-1" class="project-detail-btn w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs transition-colors">
                    View Case Study <i class="fa-solid fa-arrow-right ml-1"></i>
                </button>
            </div>
        </div>

        <!-- Project 2 (IT) -->
        <div data-category="it" class="project-card bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300">
            <div class="h-48 bg-slate-100 relative overflow-hidden">
                <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=800&auto=format&fit=crop" alt="Smart Inventory Dashboard" class="w-full h-full object-cover">
                <span class="absolute top-3 left-3 px-3 py-1 bg-blue-600 text-white text-xs font-bold rounded-full">IT & Web</span>
            </div>
            <div class="p-6">
                <h3 class="font-heading font-bold text-lg text-slate-900 mb-2">Smart Inventory Dashboard</h3>
                <p class="text-slate-600 text-xs sm:text-sm line-clamp-2 mb-4">
                    Real-time warehouse asset tracking system featuring automated reporting charts.
                </p>
                <button data-project="it-2" class="project-detail-btn w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs transition-colors">
                    View Case Study <i class="fa-solid fa-arrow-right ml-1"></i>
                </button>
            </div>
        </div>

        <!-- Project 3 (Design) -->
        <div data-category="design" class="project-card bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300">
            <div class="h-48 bg-slate-100 relative overflow-hidden">
                <img src="https://images.unsplash.com/photo-1581291518857-4e27b48ff24e?q=80&w=800&auto=format&fit=crop" alt="HealthCare Mobile App" class="w-full h-full object-cover">
                <span class="absolute top-3 left-3 px-3 py-1 bg-purple-600 text-white text-xs font-bold rounded-full">UI/UX Design</span>
            </div>
            <div class="p-6">
                <h3 class="font-heading font-bold text-lg text-slate-900 mb-2">HealthCare Mobile App Redesign</h3>
                <p class="text-slate-600 text-xs sm:text-sm line-clamp-2 mb-4">
                    Patient appointment booking & consultation UI prototype created in Figma.
                </p>
                <button data-project="design-1" class="project-detail-btn w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs transition-colors">
                    View Case Study <i class="fa-solid fa-arrow-right ml-1"></i>
                </button>
            </div>
        </div>

        <!-- Project 4 (Design) -->
        <div data-category="design" class="project-card bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300">
            <div class="h-48 bg-slate-100 relative overflow-hidden">
                <img src="https://images.unsplash.com/photo-1600132806370-bf17e65e942f?q=80&w=800&auto=format&fit=crop" alt="Corporate Brand System" class="w-full h-full object-cover">
                <span class="absolute top-3 left-3 px-3 py-1 bg-purple-600 text-white text-xs font-bold rounded-full">Branding & Graphic</span>
            </div>
            <div class="p-6">
                <h3 class="font-heading font-bold text-lg text-slate-900 mb-2">Corporate Brand Identity System</h3>
                <p class="text-slate-600 text-xs sm:text-sm line-clamp-2 mb-4">
                    Comprehensive visual brand guidelines, typography rules, and logo suite.
                </p>
                <button data-project="design-2" class="project-detail-btn w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs transition-colors">
                    View Case Study <i class="fa-solid fa-arrow-right ml-1"></i>
                </button>
            </div>
        </div>

        <!-- Project 5 (Video) -->
        <div data-category="video" class="project-card bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300">
            <div class="h-48 bg-slate-100 relative overflow-hidden">
                <img src="https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?q=80&w=800&auto=format&fit=crop" alt="Tech Summit Aftermovie" class="w-full h-full object-cover">
                <span class="absolute top-3 left-3 px-3 py-1 bg-indigo-600 text-white text-xs font-bold rounded-full">Video Editing</span>
            </div>
            <div class="p-6">
                <h3 class="font-heading font-bold text-lg text-slate-900 mb-2">Annual Tech Summit Aftermovie</h3>
                <p class="text-slate-600 text-xs sm:text-sm line-clamp-2 mb-4">
                    High-energy event reel edited in Premiere Pro with custom motion graphics.
                </p>
                <button data-project="video-1" class="project-detail-btn w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs transition-colors">
                    View Case Study <i class="fa-solid fa-arrow-right ml-1"></i>
                </button>
            </div>
        </div>

        <!-- Project 6 (Marketing) -->
        <div data-category="marketing" class="project-card bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300">
            <div class="h-48 bg-slate-100 relative overflow-hidden">
                <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=800&auto=format&fit=crop" alt="Digital Marketing Campaign" class="w-full h-full object-cover">
                <span class="absolute top-3 left-3 px-3 py-1 bg-rose-600 text-white text-xs font-bold rounded-full">Digital Marketing</span>
            </div>
            <div class="p-6">
                <h3 class="font-heading font-bold text-lg text-slate-900 mb-2">National Student Competition Campaign</h3>
                <p class="text-slate-600 text-xs sm:text-sm line-clamp-2 mb-4">
                    Multi-channel social media ad campaign achieving 140% registration targets.
                </p>
                <button data-project="marketing-1" class="project-detail-btn w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs transition-colors">
                    View Case Study <i class="fa-solid fa-arrow-right ml-1"></i>
                </button>
            </div>
        </div>

    </div>
</div>
