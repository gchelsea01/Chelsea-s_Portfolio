---
---

<section class="relative py-12 lg:py-20 overflow-hidden">
    <!-- Background Decorative Blobs -->
    <div class="absolute top-1/4 left-1/3 w-96 h-96 bg-purple-300/30 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/3 right-10 w-80 h-80 bg-purple-200/40 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

            <!-- Left Content (Name, About Me & Action Buttons) -->
            <div class="lg:col-span-8 text-left order-2 lg:order-1">
                <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-slate-100 border border-slate-200 shadow-sm mb-4">
                    <span class="flex h-2 w-2 rounded-full bg-emerald-500 mr-2.5 animate-pulse"></span>
                    <span class="text-xs font-semibold text-slate-700 tracking-wide uppercase">Open for Opportunities & Collaborations</span>
                </div>

                <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-2">
                    Hi, I'm <span class="text-gradient">Graciella Chelsea Lu</span>
                </h1>
                <p class="text-lg font-bold text-brand-purple mb-6">
                    Informatics Student @Ciputra University
                </p>

                <!-- About Me Content -->
                <div class="mb-8">
                    <h2 class="font-heading text-2xl font-bold text-slate-900 mb-3">
                        About Me
                    </h2>
                    <p class="text-slate-600 text-base sm:text-lg leading-relaxed mb-4">
                        I am a versatile and driven digital professional who thrives at the intersection of technical engineering and creative design. With multi-disciplinary expertise across <span class="font-semibold text-slate-900">IT & Web Solutions</span>, <span class="font-semibold text-slate-900">UI/UX & Graphic Design</span>, <span class="font-semibold text-slate-900">Video Editing</span>, and strategic <span class="font-semibold text-slate-900">Digital Marketing</span>, I craft seamless digital experiences that look great and deliver measurable impact.
                    </p>
                    <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
                        Whether developing modern user interfaces, editing dynamic media assets, or leading collaborative student and committee initiatives, I bring clarity, adaptability, and high standards to every project I take on.
                    </p>
                </div>

                <!-- CTAs -->
                <div class="flex flex-col sm:flex-row items-center justify-start gap-4">
                    <button id="download-cv-btn" class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-slate-800 bg-white hover:bg-slate-50 border-2 border-slate-200 shadow-sm hover:border-slate-300 transition-all duration-200">
                        <i class="fa-solid fa-download mr-2 text-brand-blue"></i> Download CV
                    </button>
                    <button id="open-contact-btn" class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-bold text-white bg-gradient-brand shadow-lg shadow-purple-500/25 hover:shadow-purple-500/40 hover:-translate-y-0.5 transition-all duration-200">
                        <i class="fa-solid fa-paper-plane mr-2"></i> Contact Me
                    </button>
                </div>
            </div>

            <!-- Right Small Circular Photo -->
            <div class="lg:col-span-4 flex justify-center items-center order-1 lg:order-2">
                <div class="relative">
                    <div class="absolute -inset-1 rounded-full bg-purple-300 blur-md opacity-50 animate-pulse"></div>
                    <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=800&auto=format&fit=crop"
                         alt="Graciella Chelsea Lu"
                         class="relative w-48 h-48 sm:w-56 sm:h-56 lg:w-64 lg:h-64 rounded-full object-cover border-4 border-white shadow-xl hover:scale-105 transition-transform duration-300"
                         onerror="this.src='https://placehold.co/400x400/8b5cf6/ffffff?text=Graciella'">
                </div>
            </div>

        </div>
    </div>
</section>
