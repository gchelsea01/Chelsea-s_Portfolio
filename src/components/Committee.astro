---
---

<section>
    <div class="flex items-center space-x-3 mb-8 pb-3 border-b border-slate-200">
        <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold">
            <i class="fa-solid fa-people-group text-lg"></i>
        </div>
        <div>
            <h2 class="font-heading text-2xl font-bold text-slate-900">Committee Experience</h2>
            <p class="text-xs text-slate-500">Event execution and project committee roles</p>
        </div>
    </div>

    <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
            <div class="lg:col-span-7">
                <span class="px-3 py-1 bg-indigo-100 text-indigo-600 text-xs font-semibold rounded-full mb-2 inline-block">Annual Tech Conference</span>
                <h3 class="font-heading text-xl font-bold text-slate-900 mb-1">Project Lead & Event Chair</h3>
                <p class="text-slate-500 text-xs mb-4">Tech Innovators Summit 2025 • Nov 2025</p>
                <p class="text-slate-600 text-sm leading-relaxed mb-4">
                    Spearheaded a 25-person event committee for a national tech seminar with 1,000+ registered attendees. Managed budget, speaker invitations, live stream production, and post-event reporting.
                </p>
            </div>
            <div class="lg:col-span-5">
                <!-- Swiper Carousel -->
                <div class="swiper committeeSwiper rounded-xl overflow-hidden border border-slate-200 shadow-sm">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            <img src="https://images.unsplash.com/photo-1475721027785-f74eccf877e2?q=80&w=800&auto=format&fit=crop" alt="Event presentation" class="w-full h-48 object-cover">
                        </div>
                        <div class="swiper-slide">
                            <img src="https://images.unsplash.com/photo-1511578314322-379afb476865?q=80&w=800&auto=format&fit=crop" alt="Committee team photo" class="w-full h-48 object-cover">
                        </div>
                    </div>
                    <div class="swiper-button-next"></div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-pagination"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import Swiper from 'swiper';
    import { Navigation, Pagination } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/navigation';
    import 'swiper/css/pagination';

    new Swiper('.committeeSwiper', {
        modules: [Navigation, Pagination],
        slidesPerView: 1,
        spaceBetween: 10,
        loop: true,
        pagination: { el: '.committeeSwiper .swiper-pagination', clickable: true },
        navigation: { nextEl: '.committeeSwiper .swiper-button-next', prevEl: '.committeeSwiper .swiper-button-prev' },
    });
</script>
