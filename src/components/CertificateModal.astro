<!-- Certificate Lightbox Modal -->
<div id="cert-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-slate-900/80 backdrop-blur-md p-4">
    <div class="relative max-w-4xl w-full bg-white rounded-2xl overflow-hidden shadow-2xl">
        <button id="close-cert-modal" class="absolute top-4 right-4 z-10 text-white bg-slate-900/60 hover:bg-slate-900 w-9 h-9 flex items-center justify-center rounded-full transition-colors">
            <i class="fa-solid fa-xmark text-lg"></i>
        </button>
        <div class="p-2 sm:p-4 bg-slate-950 flex items-center justify-center min-h-[300px] max-h-[75vh]">
            <img id="cert-modal-img" src="" alt="Certificate Full Preview" class="max-h-[70vh] w-auto object-contain rounded-lg">
        </div>
        <div class="p-4 sm:p-6 bg-white border-t border-slate-200">
            <h3 id="cert-modal-title" class="font-heading text-xl font-bold text-slate-900"></h3>
            <p id="cert-modal-meta" class="text-sm text-slate-600 mt-1"></p>
        </div>
    </div>
</div>

<script>
    document.getElementById('close-cert-modal')?.addEventListener('click', () => {
        document.getElementById('cert-modal')?.classList.add('hidden');
    });

    // Close on backdrop click
    document.getElementById('cert-modal')?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) {
            document.getElementById('cert-modal')?.classList.add('hidden');
        }
    });
</script>
