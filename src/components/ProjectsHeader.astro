---

<section class="py-12 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
            <span class="text-xs font-bold text-brand-blue tracking-widest uppercase mb-2 block">Selected Work</span>
            <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
                Projects Portfolio
            </h1>
            <p class="text-slate-600 text-base sm:text-lg">
                Explore my multi-disciplinary work spanning IT & Web Development, UI/UX Design, Video Editing, and Digital Marketing campaigns.
            </p>
        </div>

        <!-- Filter Tabs -->
        <div class="flex flex-wrap items-center gap-2 mt-8 pt-6 border-t border-slate-100">
            <button data-filter="all" class="project-filter-btn px-5 py-2.5 rounded-xl font-bold text-sm transition-all duration-200 bg-gradient-brand text-white shadow-md">
                All Projects
            </button>
            <button data-filter="it" class="project-filter-btn px-5 py-2.5 rounded-xl font-bold text-sm transition-all duration-200 bg-white text-slate-600 border border-slate-200 hover:bg-slate-50">
                IT & Web
            </button>
            <button data-filter="design" class="project-filter-btn px-5 py-2.5 rounded-xl font-bold text-sm transition-all duration-200 bg-white text-slate-600 border border-slate-200 hover:bg-slate-50">
                Design Projects
            </button>
            <button data-filter="video" class="project-filter-btn px-5 py-2.5 rounded-xl font-bold text-sm transition-all duration-200 bg-white text-slate-600 border border-slate-200 hover:bg-slate-50">
                Video Editing
            </button>
            <button data-filter="marketing" class="project-filter-btn px-5 py-2.5 rounded-xl font-bold text-sm transition-all duration-200 bg-white text-slate-600 border border-slate-200 hover:bg-slate-50">
                Digital Marketing
            </button>
        </div>
    </div>
</section>

<script>
    document.querySelectorAll('.project-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const category = btn.getAttribute('data-filter') || 'all';

            // Update tab styling
            document.querySelectorAll('.project-filter-btn').forEach(tab => {
                tab.classList.remove('bg-gradient-brand', 'text-white', 'shadow-md');
                tab.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
            });
            btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
            btn.classList.add('bg-gradient-brand', 'text-white', 'shadow-md');

            // Filter project cards
            document.querySelectorAll('.project-card').forEach(item => {
                const el = item as HTMLElement;
                const itemCategory = el.getAttribute('data-category');
                if (category === 'all' || itemCategory === category) {
                    el.style.display = 'block';
                } else {
                    el.style.display = 'none';
                }
            });
        });
    });
</script>
