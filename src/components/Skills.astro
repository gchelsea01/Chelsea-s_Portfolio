---
---

<section class="py-16 bg-slate-50 border-t border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-10">
            <h2 class="font-heading text-3xl sm:text-4xl font-extrabold text-slate-900">Skills</h2>
        </div>

        <!-- Skills Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- IT Tools -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center space-x-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-blue-50 text-brand-blue flex items-center justify-center">
                        <i class="fa-solid fa-code text-lg"></i>
                    </div>
                    <h4 class="font-heading font-bold text-slate-900 text-base">IT & Development</h4>
                </div>
                <div class="flex flex-wrap gap-2">
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">HTML/CSS</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">JavaScript</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">Tailwind CSS</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">React Basics</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">Git / GitHub</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">MySQL</span>
                </div>
            </div>

            <!-- Design Tools -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center space-x-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-purple-50 text-brand-purple flex items-center justify-center">
                        <i class="fa-solid fa-pen-nib text-lg"></i>
                    </div>
                    <h4 class="font-heading font-bold text-slate-900 text-base">Design Tools</h4>
                </div>
                <div class="flex flex-wrap gap-2">
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">Figma</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">Adobe Photoshop</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">Adobe Illustrator</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">Canva Pro</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">UI Wireframing</span>
                </div>
            </div>

            <!-- Video Editing Tools -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center space-x-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
                        <i class="fa-solid fa-video text-lg"></i>
                    </div>
                    <h4 class="font-heading font-bold text-slate-900 text-base">Video Editing</h4>
                </div>
                <div class="flex flex-wrap gap-2">
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">Adobe Premiere Pro</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">CapCut Desktop</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">After Effects</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">Color Grading</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">Audio Editing</span>
                </div>
            </div>

            <!-- Marketing Tools -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-center space-x-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center">
                        <i class="fa-solid fa-chart-line text-lg"></i>
                    </div>
                    <h4 class="font-heading font-bold text-slate-900 text-base">Marketing Tools</h4>
                </div>
                <div class="flex flex-wrap gap-2">
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">Meta Ads Manager</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">Google Analytics</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">SEO Content</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">Copywriting</span>
                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs rounded-md font-medium">Social Analytics</span>
                </div>
            </div>
        </div>
    </div>
</section>
