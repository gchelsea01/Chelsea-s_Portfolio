---
import Layout from '../layouts/Layout.astro';
import ExperienceHeader from '../components/ExperienceHeader.astro';
import WorkExperience from '../components/WorkExperience.astro';
import Organization from '../components/Organization.astro';
import Committee from '../components/Committee.astro';
import Certificates from '../components/Certificates.astro';
import CertificateModal from '../components/CertificateModal.astro';
---

<Layout title="Experience & Credentials | Graciella Chelsea Lu">
    <ExperienceHeader />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
        <WorkExperience />
        <Organization />
        <Committee />
        <Certificates />
    </div>
    <CertificateModal />
</Layout>
